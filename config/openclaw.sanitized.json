{
  "auth": {
    "profiles": {
      "cerebras:manual": {
        "provider": "cerebras",
        "mode": "api_key"
      }
    }
  },
  "plugins": {
    "entries": {
      "cerebras": {
        "enabled": true
      }
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.11.6"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras trial)",
            "input": [
              "text",
              "image"
            ],
            "reasoning": true,
            "contextWindow": 131072,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<REDACTED_GATEWAY_TOKEN>"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
